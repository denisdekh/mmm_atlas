@page
@{
    ViewData["Title"] = "Community game map";
    ViewData["Page"] = "home";
}

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">A community map of how games play</p>
        <h1>Every game has a different strategic shape.</h1>
        <iframe
            class="hero-video"
            src="https://www.youtube.com/embed/NgHvdCcmQ4o?si=bxRATieshzO2Gjqo"
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
    </div>

    <div class="axis-orbit" aria-hidden="true">
        <span class="orbit orbit-one"></span>
        <span class="orbit orbit-two"></span>
        <span class="orbit orbit-three"></span>
        <strong>MMM</strong>
    </div>
</section>

<section class="axis-explorer" id="atlas">
    <div class="section-heading">
        <p class="eyebrow">The three axes</p>
        <h2>The three dimensions of comptetitive play.</h2>
    </div>

    <div class="axis-grid">
        <article class="axis-card axis-micro">
            <span class="axis-index">01</span>
            <img class="axis-icon axis-card-icon" src="~/images/axis-micro.svg" alt="" aria-hidden="true" />
            <strong>Micro</strong>
            <span>Requires mechanical skill, fast reactions, and quick inputs</span>
        </article>
        <article class="axis-card axis-meso">
            <span class="axis-index">02</span>
            <img class="axis-icon axis-card-icon" src="~/images/axis-meso.svg" alt="" aria-hidden="true" />
            <strong>Meso</strong>
            <span>Requires guessing your opponents, learning their habits, and acting under rng</span>
        </article>
        <article class="axis-card axis-macro">
            <span class="axis-index">03</span>
            <img class="axis-icon axis-card-icon" src="~/images/chess.svg" alt="" aria-hidden="true" />
            <strong>Macro</strong>
            <span>Requires calculating, strategizing, and long term planning</span>
        </article>
    </div>
</section>

<section class="game-api-demo atlas-launch" id="games">
    <a class="atlas-launch-action" asp-page="/Atlas">
        <span>
            <span class="eyebrow">The living atlas</span>
            <strong>Explore the full game atlas.</strong>
            <span>
                Pan, zoom, filter, and inspect how community-rated games are
                distributed across Micro, Meso, and Macro.
            </span>
        </span>
        <span class="atlas-launch-arrow" aria-hidden="true">→</span>
    </a>
</section>

<section class="about" id="about">
    <p class="eyebrow">How it will work</p>
    <ol class="steps">
        <li><span>01</span>Sign in through Steam.</li>
        <li><span>02</span>Choose a game you own.</li>
        <li><span>03</span>Rate its Micro, Meso, and Macro character.</li>
        <li><span>04</span>See the community result move on the atlas.</li>
    </ol>
</section>
