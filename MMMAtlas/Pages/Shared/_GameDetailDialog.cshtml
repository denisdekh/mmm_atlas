<dialog
    class="game-detail-dialog"
    data-game-detail-dialog
    aria-labelledby="game-detail-dialog-title">
    <div class="game-detail-dialog-header">
        <h2 id="game-detail-dialog-title" data-game-detail-title>Game details</h2>
        <button
            class="dialog-close-button"
            type="button"
            data-game-detail-close
            aria-label="Close game details">Close</button>
    </div>

    <div
        class="game-detail-dialog-content"
        data-game-detail-content
        aria-live="polite"></div>
</dialog>
