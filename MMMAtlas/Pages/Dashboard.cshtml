@page "/dashboard"
@model MMMAtlas.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Page"] = "dashboard";
}

<section class="dashboard-page">
    <header class="dashboard-heading">
        <div>
            <p class="eyebrow">Your MMM Atlas account</p>
            <h1>Steam dashboard</h1>
        </div>
        <p>
            Manage your Steam data, vote privacy, and the games you play most.
        </p>
    </header>

    @if (Model.Notice == "erased")
    {
        <p class="dashboard-notice">Your stored Steam profile and library data has been cleared. Your submitted votes were retained.</p>
    }
    else if (Model.Notice == "collection-enabled")
    {
        <p class="dashboard-notice">Data collection is enabled. Your Steam profile and library have been fetched.</p>
    }
    else if (Model.Notice == "votes-private")
    {
        <p class="dashboard-notice">All of your votes are now private.</p>
    }

    @if (Model.Dashboard is null)
    {
        <div class="dashboard-empty">
            <p>Your Steam account could not be loaded.</p>
        </div>
    }
    else
    {
        <div class="dashboard-grid">
        <section class="dashboard-card dashboard-profile-card">
            <p class="dashboard-card-index">01 / Profile</p>

            @if (Model.Dashboard.PersonaName is not null)
            {
                <div class="dashboard-profile">
                    @if (Model.Dashboard.AvatarUrl is not null)
                    {
                        <img
                            src="@Model.Dashboard.AvatarUrl"
                            alt=""
                            width="96"
                            height="96" />
                    }

                    <div>
                        <h2>@Model.Dashboard.PersonaName</h2>

                        @if (Model.Dashboard.ProfileUrl is not null)
                        {
                            <a class="dashboard-text-link" href="@Model.Dashboard.ProfileUrl">Open Steam profile <span aria-hidden="true">↗</span></a>
                        }
                    </div>
                </div>
            }
            else
            {
                <h2>Steam profile</h2>
                <p>No Steam profile data is stored.</p>
            }
        </section>

        <section class="dashboard-card">
            <p class="dashboard-card-index">02 / Visibility</p>
            <h2>Vote privacy</h2>
            <p>
                Private votes still contribute to game scores, but your Steam
                profile name is not shown with them.
            </p>
            <form method="post" action="/api/me/votes/private">
                @Html.AntiForgeryToken()
                <button class="ui-button" type="submit">Make all votes private</button>
            </form>
        </section>

        <section class="dashboard-card">
            <p class="dashboard-card-index">03 / Permissions</p>
            <h2>Data collection</h2>

            @if (Model.Dashboard.DataCollectionEnabled)
            {
                <p>
                    Collection is enabled for your Steam profile, game library,
                    and playtime.
                </p>
                <div class="dashboard-data-actions">
                    <button class="ui-button" type="button" data-steam-opt-out>
                        Stop data collection
                    </button>
                    <form method="post" action="/api/me/steam-data/refresh" data-steam-refresh>
                        @Html.AntiForgeryToken()
                        <button class="ui-button" type="submit">Refresh library</button>
                    </form>
                </div>

            }
            else
            {
                <p>
                    Collection is disabled. MMM Atlas will not fetch or store
                    your Steam profile, game library, or playtime unless you
                    grant permission.
                </p>
                <form method="post" action="/api/me/steam-data/consent">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="enabled" value="true" />
                    <button class="ui-button ui-button-primary" type="submit">Allow data collection</button>
                </form>
            }
        </section>

        <section class="dashboard-card dashboard-games-card @(Model.Dashboard.LibraryCheckStatus == "Private" ? "dashboard-games-card-private" : null)">
            <div class="dashboard-card-heading">
                <div>
                    <p class="dashboard-card-index">04 / Library</p>
                    <h2>Most played games</h2>
                </div>
                @if (Model.Dashboard.LibraryCheckStatus == "Private")
                {
                    <span class="axis-tooltip dashboard-library-status-tooltip">
                        <button
                            type="button"
                            class="dashboard-status dashboard-status-private"
                            data-axis-tooltip="library-private"
                            aria-describedby="dashboard-library-private-tooltip">Private</button>
                        <span
                            class="axis-tooltip-bubble"
                            id="dashboard-library-private-tooltip"
                            role="tooltip">
                            <strong>A public Steam library is required to cast a vote.</strong>
                            Open Steam, select your name, and go to your profile.
                            Choose Edit Profile → Privacy Settings, then set both
                            My profile and Game details to Public.
                            Sign in to MMM Atlas again to load your game library and playtime.
                            Once your data has been collected, you can make your
                            Steam profile and game details private again and continue voting.
                        </span>
                    </span>
                }
                else
                {
                    <span class="dashboard-status">@Model.Dashboard.LibraryCheckStatus</span>
                }
            </div>

            @if (Model.Dashboard.DataCollectionEnabled)
            {
                <form
                    class="dashboard-library-search"
                    action="/dashboard"
                    method="get"
                    role="search"
                    data-dashboard-library-search>
                    <label class="visually-hidden" for="dashboard-library-query">Search your Steam library</label>
                    <div class="dashboard-library-search-control">
                        <input
                            id="dashboard-library-query"
                            name="q"
                            type="search"
                            maxlength="100"
                            autocomplete="off"
                            placeholder="Search your Steam library"
                            data-dashboard-library-query />
                        <button
                            type="button"
                            data-dashboard-library-clear
                            hidden>Clear</button>
                    </div>
                    <output data-dashboard-library-status aria-live="polite">Search your stored library.</output>
                </form>
            }

            <div data-dashboard-games-region>
                <div data-dashboard-games-initial>
                    @if (Model.Dashboard.MostPlayedGames.Count == 0)
                    {
                        <p class="dashboard-games-empty">No game data is stored.</p>
                    }
                    else
                    {
                        <ol class="dashboard-games">
                            @foreach (var game in Model.Dashboard.MostPlayedGames)
                            {
                                <li class="dashboard-game">
                                    <button
                                        type="button"
                                        class="dashboard-game-details"
                                        data-game-detail-trigger
                                        data-game-id="@game.GameId"
                                        data-game-title="@game.Name"
                                        aria-label="View details for @game.Name">
                                        <img
                                            class="dashboard-game-artwork is-loading"
                                            data-game-id="@game.GameId"
                                            src="@(game.LibraryCardUrl ?? $"/api/games/{game.GameId}/library-card")"
                                            alt="@game.Name"
                                            width="96"
                                            height="144"
                                            loading="lazy" />
                                    </button>
                                    <small class="dashboard-game-playtime">@((game.PlaytimeForeverMinutes / 60d).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) hrs</small>
                                </li>
                            }
                        </ol>
                        <div class="dashboard-games-more">
                            <button class="ui-button" type="button" data-dashboard-games-more>Load more</button>
                            <output data-dashboard-games-more-status aria-live="polite"></output>
                        </div>
                    }
                    <p class="dashboard-games-empty" data-dashboard-artwork-empty hidden>No games available</p>
                </div>
                <div data-dashboard-games-results hidden></div>
            </div>
        </section>
        </div>
    }
</section>

@if (Model.Dashboard?.DataCollectionEnabled == true)
{
    <dialog
        class="vote-dialog"
        data-steam-opt-out-dialog
        aria-labelledby="steam-opt-out-title"
        aria-describedby="steam-opt-out-description">
        <div class="vote-dialog-header">
            <h2 id="steam-opt-out-title">Stop data collection?</h2>
            <button class="dialog-close-button" type="button" data-steam-opt-out-cancel aria-label="Close">
                Close
            </button>
        </div>
        <p id="steam-opt-out-description">
            Opting out will delete your stored Steam profile, game library, and
            playtime data. Your submitted votes will not be deleted.
        </p>
        <form method="post" action="/api/me/steam-data/consent">
            @Html.AntiForgeryToken()
            <input type="hidden" name="enabled" value="false" />
            <div class="vote-dialog-actions">
                <button class="ui-button" type="button" data-steam-opt-out-cancel>Keep collection enabled</button>
                <button class="ui-button ui-button-danger" type="submit">Stop collection and delete game data</button>
            </div>
        </form>
    </dialog>
}

<div class="vote-toast-region" data-steam-refresh-toast role="status" aria-live="polite" aria-atomic="true"></div>

@section Scripts {
    <script type="module" src="~/js/dashboard-steam-refresh.js" asp-append-version="true"></script>
    <script type="module" src="~/js/dashboard-data-consent.js" asp-append-version="true"></script>
    <script type="module" src="~/js/dashboard-library-search.js" asp-append-version="true"></script>
}
