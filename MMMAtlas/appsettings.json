{
  "ConnectionStrings": {
    "MMMAtlasDevelopment": "Data Source=App_Data/mmm-atlas-development.db;Foreign Keys=True;Default Timeout=5",
    "MMMAtlasProfiler": "Data Source=App_Data/mmm-atlas-profiler.db;Foreign Keys=True;Default Timeout=5",
    "MMMAtlasProduction": "Data Source=App_Data/mmm-atlas.db;Foreign Keys=True;Default Timeout=5"
  },
  "Steam": {
    "Metadata": {
      "BatchSize": 100
    },
    "LibraryFilters": {
      "RequireGameType": false,
      "ExcludeBeta": false
    }
  },
  "DevelopmentData": {
    "SeedOnStartup": false
  },
  "Logging": {
    "File": {
      "Enabled": true,
      "Path": "App_Data/Logs/mmm-atlas-.log",
      "FileSizeLimitBytes": 10485760,
      "RetainedFileCountLimit": 14
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
